{
  "name": "vortexdownloader",
  "private": true,
  "version": "0.6.9",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:server\"",
    "dev:vite": "cd frontend && npx vite --port=3000 --host=0.0.0.0",
    "dev:server": "cd backend && go run ./cmd/server",
    "server": "cd backend && go run ./cmd/server",
    "build:server": "cd backend && go build -o bin/vortex-engine.exe ./cmd/server",
    "start": "cd backend && go run ./cmd/server",
    "server:python": "cd backend && python server.py",
    "build": "cd frontend && npx vite build",
    "preview": "cd frontend && npx vite preview",
    "server:go": "cd backend && go run ./cmd/server",
    "clean": "node -e \"['frontend/dist', 'backend/__pycache__'].forEach(p => fs.rmSync(p, {recursive: true, force: true}))\"",
    "lint": "cd frontend && tsc --noEmit",
    "generate:icons": "node scripts/generate-icons.js",
    "bundle:binaries": "node scripts/bundle-binaries.js",
    "cap:sync": "npx cap sync android",
    "build:apk": "node scripts/generate-icons.js && node scripts/bundle-binaries.js && npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@google/genai": "^2.4.0",
    "@material/web": "^2.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "material-symbols": "^0.47.1",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@esbuild/win32-x64": "^0.28.2",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
