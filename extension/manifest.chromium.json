{
  "manifest_version": 3,
  "name": "EDM — Edge Download Manager",
  "version": "0.0.5",
  "description": "High-performance live download dashboard and acceleration integration for EDM",
  "key": "",
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "contextMenus",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EDM Live Dashboard",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
